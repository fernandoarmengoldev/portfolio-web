---
import Badge from "./Badge.astro";
import SocialPill from "./SocialPill.astro";
import Experience from "./Experience.astro";
import Projects from "./Projects.astro";
---

<main class="px-5 mx-auto max-w-3xl w-full">
    <section id="top" class="py-20">
        <div class="flex items-center gap-x-5 pb-10">
            <img
                class="rounded-full w-30 h-30"
                src="/fernando.png"
                alt="Fernando Daniel"
            />
            <Badge>Disponible para trabajar</Badge>
        </div>

        <h1 class="text-4xl font-bold pb-5">Fernando Daniel</h1>
        <h2 class="text-2xl pb-5">
            Desarrollador Fullstack con experiencia en desarrollo Web y Android.
        </h2>
        <h2 class="text-2xl pb-5">
            Centrado en tecnologias de alto rendimiento.
        </h2>

        <nav class="flex gap-x-5 mt-5">
            <SocialPill href="https://github.com/fernandoarmengoldev">
                GitHub
                <svg class="size-6">
                    <use href="/sprite.svg#icon-github"></use>
                </svg>
            </SocialPill>

            <SocialPill
                href="https://www.linkedin.com/in/fernando-armengol-gonz%C3%A1lez-090209265/"
            >
                Linkedin
                <svg class="size-6">
                    <use href="/sprite.svg#icon-linkedin"></use>
                </svg>
            </SocialPill>
        </nav>
    </section>

    <section id="experience" class="pb-20">
        <h2 class="text-2xl font-semibold pb-5 flex items-center gap-x-5">
            <svg class="size-6 fill-white">
                <use href="/sprite.svg#icon-work"></use>
            </svg>
            Experiencia laboral</h2>
        <Experience />
    </section>

    <section id="projects" class="pb-20">
        <h2 class="text-2xl font-semibold pb-5 flex items-center gap-x-5">
            <svg class="size-6 fill-white">
                <use href="/sprite.svg#icon-code"></use>
            </svg>
            Proyectos</h2>
        <Projects />
    </section>

</main>
