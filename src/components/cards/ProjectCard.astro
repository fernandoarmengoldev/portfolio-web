---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../data/profile';
import { getTranslations } from '../../i18n/translations';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  detailPath: string;
}

const { project, locale, detailPath } = Astro.props;
const t = getTranslations(locale);
const titleId = `project-${project.data.translationKey}`;
---

<article class="project" aria-labelledby={titleId}>
  <a class="cover" href={detailPath} tabindex="-1" aria-hidden="true">
    <Picture
      src={project.data.image}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[480, 720, 960]}
      sizes="(max-width: 899px) 92vw, 30vw"
      alt=""
      loading="lazy"
      decoding="async"
      class="cover-image"
    />
  </a>
  <div class="body">
    <p class="year">{project.data.year}</p>
    <h3 id={titleId}>
      <a href={detailPath}>{project.data.title}</a>
    </h3>
    <p class="summary">{project.data.summary}</p>
    <ul class="stack-list" aria-label={t.project.technologies}>
      {project.data.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    {(project.data.githubUrl || project.data.demoUrl) && (
      <p class="links">
        {project.data.githubUrl && (
          <a class="text-link" href={project.data.githubUrl} target="_blank" rel="noreferrer">
            <Icon name="simple-icons:github" class="icon" aria-hidden="true" />
            {t.projects.repo}
          </a>
        )}
        {project.data.demoUrl && (
          <a class="text-link" href={project.data.demoUrl} target="_blank" rel="noreferrer">
            <Icon name="tabler:external-link" class="icon" aria-hidden="true" />
            {t.projects.demo}
          </a>
        )}
      </p>
    )}
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: 1.25rem;
  }

  .cover {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
  }

  :global(.cover-image) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .project:hover :global(.cover-image) {
    transform: scale(1.03);
  }

  .year {
    color: var(--tide);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin-top: 0.25rem;
    font-size: var(--step-2);
    font-stretch: 108%;
    font-weight: 680;
    line-height: 1.15;
  }

  h3 a:hover {
    color: var(--caustic);
  }

  .summary {
    max-width: 58ch;
    margin-top: 0.6rem;
    color: var(--tide);
  }

  .stack-list {
    margin-top: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  @media (min-width: 900px) {
    .project {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: 2rem;
    }
  }
</style>
