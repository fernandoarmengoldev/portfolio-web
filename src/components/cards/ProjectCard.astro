---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../data/profile';
import { getTranslations } from '../../i18n/translations';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  detailPath: string;
  featured?: boolean;
}

const { project, locale, detailPath, featured = false } = Astro.props;
const t = getTranslations(locale);
const titleId = `project-${project.data.translationKey}`;
---

<article class:list={['project-card card-surface', { featured }]} data-reveal aria-labelledby={titleId}>
  <a class="project-image-link" href={detailPath} aria-label={`${t.projects.details}: ${project.data.title}`}>
    <Picture
      src={project.data.image}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={featured ? [640, 960, 1280] : [480, 720, 960]}
      sizes={featured ? '(max-width: 767px) 94vw, 62vw' : '(max-width: 767px) 94vw, 36vw'}
      alt={project.data.imageAlt}
      loading="lazy"
      decoding="async"
      class="project-image"
    />
  </a>
  <div class="project-content">
    <div class="project-topline">
      <span class="placeholder-label">{t.projects.placeholder}</span>
      <span class="project-year">{project.data.year}</span>
    </div>
    <h3 id={titleId}>{project.data.title}</h3>
    <p>{project.data.summary}</p>
    <ul class="tech-list" aria-label={t.project.technologies}>
      {project.data.technologies.map((technology) => <li class="tag">{technology}</li>)}
    </ul>
    <div class="project-links">
      <a class="link-arrow" href={detailPath}>
        {t.projects.details}
        <Icon name="tabler:arrow-right" class="icon-inline" aria-hidden="true" />
      </a>
      {project.data.githubUrl && (
        <a href={project.data.githubUrl} target="_blank" rel="noreferrer">
          <Icon name="simple-icons:github" class="icon-inline" aria-hidden="true" />
          {t.projects.repo}
        </a>
      )}
      {project.data.demoUrl && (
        <a href={project.data.demoUrl} target="_blank" rel="noreferrer">
          <Icon name="tabler:external-link" class="icon-inline" aria-hidden="true" />
          {t.projects.demo}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), border-color 220ms ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
  }

  .project-image-link {
    display: block;
    overflow: hidden;
    background: var(--surface-soft);
  }

  :global(.project-image) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover :global(.project-image) {
    transform: scale(1.025);
  }

  .project-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.2rem, 2.7vw, 2rem);
  }

  .project-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-year {
    color: var(--text-faint);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
  }

  h3 {
    margin: 1rem 0 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 680;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  p {
    margin: 0.8rem 0 0;
    color: var(--text-muted);
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .project-links > a:not(.link-arrow) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .project-links > a:not(.link-arrow):hover {
    color: var(--text);
  }

  @media (min-width: 900px) {
    .project-card.featured {
      grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
    }

    .project-card.featured .project-image-link,
    .project-card.featured :global(.project-image) {
      height: 100%;
      min-height: 26rem;
    }
  }
</style>
