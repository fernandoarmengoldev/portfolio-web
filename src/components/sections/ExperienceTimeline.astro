---
import type { Locale } from '../../data/profile';
import { experience } from '../../data/experience';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const yearSpan = (period: string) => [...new Set(period.match(/\d{4}/g) ?? [])].join('–');
---

<ol class="timeline">
  {experience.map((item) => (
    <li class="entry" data-reveal>
      <p class="years" aria-hidden="true">{yearSpan(item.period.en)}</p>
      <article>
        <h3>{item.role[locale]}</h3>
        <p class="company">{item.company}</p>
        <p class="meta">
          <time>{item.period[locale]}</time>
          <span>{item.location[locale]}</span>
        </p>
        <ul class="duties">
          {item.responsibilities[locale].map((responsibility) => <li>{responsibility}</li>)}
        </ul>
        <ul class="stack-list" aria-label={locale === 'es' ? 'Tecnologías utilizadas' : 'Technologies used'}>
          {item.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </article>
    </li>
  ))}
</ol>

<style>
  .timeline {
    position: relative;
    display: grid;
    padding: 0;
    list-style: none;
  }

  .entry {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 0 0 3.5rem 1.75rem;
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  /* Depth line; draws downwards when the entry is revealed */
  .entry::after {
    position: absolute;
    top: 0.6rem;
    bottom: -0.6rem;
    left: 0;
    width: 1px;
    background: var(--rule);
    content: '';
    transform-origin: top;
    transition: transform 1200ms var(--ease-out) 250ms;
  }

  .entry:last-child::after {
    display: none;
  }

  :global(html.js-motion) .entry:not(.is-visible)::after {
    transform: scaleY(0);
  }

  :global(html.js-motion) .entry:not(.is-visible)::before {
    transform: scale(0);
  }

  /* Sounding marker on the depth line */
  .entry::before {
    position: absolute;
    top: 0.55rem;
    z-index: 1;
    left: -0.27rem;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--caustic);
    border-radius: 50%;
    background: var(--abyss);
    content: '';
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1) 150ms;
  }

  .entry:first-child::before {
    background: var(--caustic);
    box-shadow: 0 0 0 0.3rem rgba(139, 234, 240, 0.14);
  }

  .years {
    color: var(--caustic);
    font-size: var(--step-1);
    font-stretch: 118%;
    font-weight: 650;
    line-height: 1.2;
  }

  h3 {
    font-size: var(--step-2);
    font-stretch: 108%;
    font-weight: 680;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .company {
    margin-top: 0.3rem;
    font-size: var(--step-0);
    font-weight: 550;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.25rem;
    margin-top: 0.2rem;
    color: var(--tide);
    font-size: var(--step--1);
  }

  .duties {
    display: grid;
    gap: 0.5rem;
    max-width: 62ch;
    margin-top: 1.25rem;
    padding-left: 1.1rem;
    color: var(--spray);
    list-style: disc;
  }

  .duties li::marker {
    color: var(--tide);
  }

  .stack-list {
    margin-top: 1.25rem;
  }

  @media (min-width: 700px) {
    .entry {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 2rem;
      padding-left: 2.25rem;
    }

    .years {
      padding-top: 0.2rem;
    }
  }
</style>
