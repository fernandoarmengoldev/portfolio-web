---
import TechIcon from './TechIcon.astro';
import type { Locale } from '../../data/profile';
import { otherTechnologies, technologyCategories } from '../../data/technologies';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<div class="stacks">
  <section aria-labelledby="main-stack-title">
    <h3 id="main-stack-title" class="group-title" data-reveal>{t.technologies.main}</h3>
    <dl class="legend">
      {technologyCategories.map((category) => (
        <div class="row">
          <dt data-reveal>{t.technologies.categories[category.key]}</dt>
          <dd>
            <ul data-reveal-stagger>
              {category.items.map((technology) => (
                <li>
                  <TechIcon technology={technology} />
                  {technology.name}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="other-stack-title">
    <h3 id="other-stack-title" class="group-title" data-reveal>{t.technologies.other}</h3>
    <ul class="other" data-reveal-stagger>
      {otherTechnologies.map((technology) => (
        <li>
          <TechIcon technology={technology} />
          {technology.name}
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .stacks {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .group-title {
    margin-bottom: 1.5rem;
    font-size: var(--step-1);
    font-stretch: 108%;
    font-weight: 680;
    line-height: 1.25;
  }

  .legend {
    display: grid;
    margin: 0;
  }

  .row {
    display: grid;
    gap: 0.75rem;
    border-bottom: 1px solid var(--rule);
    padding-block: 1.5rem;
  }

  .row:first-child {
    padding-top: 0;
  }

  dt {
    color: var(--tide);
    font-size: var(--step--1);
    font-weight: 550;
  }

  dd {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 2rem;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--spray);
    font-size: var(--step-1);
    font-weight: 560;
    line-height: 1.3;
  }

  /* Secondary list: same tiles, one step quieter in size */
  .other {
    gap: 0.85rem 1.6rem;
  }

  .other li {
    font-size: var(--step-0);
    font-weight: 520;
  }

  .other :global(.tech-icon) {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Brand tiles keep their own colours and rounded-square shape */
  :global(.tech-icon) {
    width: 1.85rem;
    height: 1.85rem;
    flex: none;
    transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  li:hover :global(.tech-icon) {
    transform: translateY(-3px) rotate(-8deg) scale(1.08);
  }

  @media (min-width: 700px) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr);
      align-items: start;
      gap: 2rem;
    }

    /* Line the label up with the first row of tiles */
    dt {
      padding-top: 0.3rem;
    }
  }
</style>
