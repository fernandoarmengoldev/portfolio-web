---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../data/profile';
import { profile } from '../../data/profile';
import { getTranslations } from '../../i18n/translations';
import profileImage from '../../assets/images/fernando-armengol.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const [role] = t.hero.eyebrow.split(' · ');
---

<section id="home" class="hero" data-water-window>
  <div class="shell hero-inner">
    <div class="identity">
      <Picture
        src={profileImage}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[80, 120, 160]}
        sizes="80px"
        alt={t.hero.imageAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="portrait"
      />
      <p class="role">
        <span>{role}</span>
        <span class="status">
          <span class="status-glow" aria-hidden="true"></span>
          <span class="status-label">{profile.availability[locale]}</span>
        </span>
      </p>
    </div>

    <h1 class="name">
      <span>Fernando D.</span>
      <span>Armengol Gonzalez</span>
    </h1>

    <div class="waterline" aria-hidden="true"></div>

    <div class="hero-foot">
      <p class="pitch">
        {t.hero.description}
        <span>{t.hero.secondary}</span>
      </p>
      <div class="hero-actions">
        <a class="btn btn-solid" href="#contact">{t.hero.contact}</a>
        <a class="btn" href={profile.githubUrl} target="_blank" rel="noreferrer">
          <Icon name="simple-icons:github" class="icon" aria-hidden="true" />
          GitHub
        </a>
        <a class="btn" href={profile.linkedinUrl} target="_blank" rel="noreferrer">
          <Icon name="simple-icons:linkedin" class="icon" aria-hidden="true" />
          LinkedIn
        </a>
      </div>
      <p class="place">
        <span>{t.contact.location}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 68svh;
    align-items: flex-end;
    padding-top: calc(var(--nav-height) + 2rem);
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  /* Darken the lower water so the copy stays readable, and blend into the page */
  .hero::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(4, 22, 30, 0.55) 70%, var(--abyss) 100%);
    content: '';
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .identity :global(picture) {
    flex: none;
  }

  :global(.portrait) {
    width: 4.25rem;
    height: 4.25rem;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--rule-strong);
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
  }

  /* Availability pill: a 1px window onto a spinning conic gradient */
  .status {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    overflow: hidden;
    border-radius: 1rem;
    padding: 1px;
  }

  .status-glow {
    position: absolute;
    inset: -1000%;
    background: conic-gradient(from 90deg at 50% 50%, var(--caustic) 0%, var(--posidonia) 50%, var(--caustic) 100%);
    animation: spin 2.5s linear infinite;
  }

  .status-label {
    position: relative;
    border-radius: 1rem;
    background: var(--trench);
    padding: 0.2rem 0.8rem;
    color: var(--caustic);
    font-size: var(--step--1);
    font-weight: 550;
    line-height: 1.35;
  }

  /* On narrow screens the Spanish label can wrap to two lines */
  @media (max-width: 480px) {
    .status-label {
      padding-inline: 0.65rem;
      font-size: 0.8125rem;
    }
  }

  .name {
    display: grid;
    font-size: clamp(2.25rem, 9.5vw, 3.5rem);
    font-stretch: 125%;
    font-weight: 820;
    letter-spacing: -0.025em;
    line-height: 1;
    animation: unfurl 1400ms var(--ease-out) both;
  }

  .waterline {
    height: 1px;
    margin-block: clamp(1.75rem, 4vw, 2.75rem);
    background: linear-gradient(90deg, var(--caustic), var(--rule) 60%, transparent);
    transform-origin: left;
    animation: draw 1100ms 350ms var(--ease-out) both;
  }

  .hero-foot {
    display: grid;
    gap: 1.75rem;
    animation: surface 800ms 700ms var(--ease-out) both;
  }

  .pitch {
    max-width: 42ch;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.45;
  }

  .pitch span {
    display: block;
    margin-top: 0.4rem;
    color: var(--tide);
    font-size: var(--step-0);
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .place {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--tide);
    font-size: var(--step--1);
  }

  @media (min-width: 900px) {
    .name {
      font-size: clamp(3rem, 4.8vw, 5rem);
    }

    .hero-foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 1.5rem 3rem;
    }

    .hero-actions {
      justify-content: flex-end;
    }

    .place {
      grid-column: 1 / -1;
    }
  }

  @keyframes unfurl {
    from {
      opacity: 0;
      font-stretch: 75%;
      letter-spacing: -0.06em;
    }
    40% {
      opacity: 1;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes surface {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>
