---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../data/profile';
import { profile } from '../../data/profile';
import { getTranslations } from '../../i18n/translations';
import profileImage from '../../assets/images/fernando-armengol.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="home" class="hero-section">
  <div class="hero-ambient ambient-one" aria-hidden="true"></div>
  <div class="hero-ambient ambient-two" aria-hidden="true"></div>
  <div class="container-shell hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="hero-eyebrow">{t.hero.eyebrow}</p>
      <div class="hero-identity">
        <div class="portrait-frame glass">
          <Picture
            src={profileImage}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[96, 144, 192, 256]}
            sizes="(max-width: 520px) 72px, (max-width: 899px) 96px, 132px"
            alt={t.hero.imageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="portrait-image"
          />
        </div>
        <h1>Fernando D. Armengol Gonzalez</h1>
      </div>
      <p class="hero-description">
        <span>{t.hero.description}</span>
        <span>{t.hero.secondary}</span>
      </p>
      <div class="hero-actions">
        <a class="button button-secondary" href={profile.githubUrl} target="_blank" rel="noreferrer">
          <Icon name="simple-icons:github" class="icon-inline" aria-hidden="true" />
          GitHub
        </a>
        <a class="button button-secondary" href={profile.linkedinUrl} target="_blank" rel="noreferrer">
          <Icon name="simple-icons:linkedin" class="icon-inline" aria-hidden="true" />
          LinkedIn
        </a>
        <a class="button button-primary" href="#contact">{t.hero.contact}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    display: grid;
    min-height: 100dvh;
    align-items: center;
    overflow: hidden;
    padding-top: 6rem;
    padding-bottom: 2.5rem;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(100%, 74rem);
    padding-right: clamp(0rem, 5vw, 4rem);
  }

  .hero-eyebrow {
    width: fit-content;
    margin: 0 0 1.25rem;
    color: var(--accent-strong);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: clamp(0.68rem, 1.3vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-identity {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 2.8vw, 2rem);
  }

  h1 {
    margin: 0;
    color: #c8d9e0;
    font-size: clamp(2.4rem, 6.4vw, 5.1rem);
    font-weight: 680;
    letter-spacing: -0.065em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .hero-description {
    display: grid;
    max-width: 46rem;
    gap: 0.2rem;
    margin: 1.4rem 0 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.8rem;
  }

  .portrait-frame {
    position: relative;
    width: clamp(5.75rem, 10vw, 8.25rem);
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow: 0 1.25rem 3rem rgba(3, 13, 20, 0.28);
  }

  :global(.portrait-image) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 34%;
    transform: scale(1.45);
    transform-origin: 50% 34%;
  }

  .portrait-frame::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 60%, rgba(2, 8, 12, 0.58)),
      linear-gradient(105deg, rgba(255, 255, 255, 0.08), transparent 28%);
    content: "";
    pointer-events: none;
  }

  .hero-ambient {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(70px);
  }

  .ambient-one {
    top: 10%;
    right: 7%;
    width: 26rem;
    height: 26rem;
    background: rgba(22, 119, 151, 0.12);
  }

  .ambient-two {
    bottom: 4%;
    left: -10%;
    width: 24rem;
    height: 20rem;
    background: rgba(42, 76, 112, 0.1);
  }

  @media (max-width: 899px) {
    .hero-section {
      min-height: auto;
      padding-top: 7rem;
      padding-bottom: 4rem;
    }

    .hero-copy {
      padding-right: 0;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .hero-actions .button:first-child {
      grid-column: 1 / -1;
    }

  }

  @media (max-width: 520px) {
    .hero-identity {
      align-items: start;
      gap: 0.85rem;
    }

    .portrait-frame {
      width: 4.5rem;
    }

    h1 {
      font-size: clamp(2rem, 10vw, 2.75rem);
      line-height: 0.98;
    }

    .hero-actions {
      grid-template-columns: 1fr;
    }

    .hero-actions .button:first-child {
      grid-column: auto;
    }

  }

  @media (prefers-reduced-motion: no-preference) {
    .ambient-one {
      animation: drift-one 14s ease-in-out infinite alternate;
    }

    .ambient-two {
      animation: drift-two 18s ease-in-out infinite alternate;
    }

    @keyframes drift-one {
      to { transform: translate3d(-2rem, 1.5rem, 0); }
    }

    @keyframes drift-two {
      to { transform: translate3d(2rem, -1rem, 0); }
    }
  }
</style>
