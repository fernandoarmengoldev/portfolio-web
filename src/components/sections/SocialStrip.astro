---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../data/profile';
import { profile } from '../../data/profile';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<div class="container-shell social-wrap" data-reveal>
  <div class="social-strip">
    <a href={profile.githubUrl} target="_blank" rel="noreferrer" aria-label={t.social.github}>
      <Icon name="simple-icons:github" class="social-icon" aria-hidden="true" />
      <span>GitHub</span>
    </a>
    <a href={`mailto:${profile.email}`} aria-label={t.social.email}>
      <Icon name="simple-icons:gmail" class="social-icon" aria-hidden="true" />
      <span>{profile.email}</span>
    </a>
    {profile.linkedinUrl ? (
      <a href={profile.linkedinUrl} target="_blank" rel="noreferrer" aria-label={t.social.linkedin}>
        <Icon name="simple-icons:linkedin" class="social-icon" aria-hidden="true" />
        <span>LinkedIn</span>
      </a>
    ) : (
      <span class="disabled-social" aria-label={t.social.linkedin}>
        <Icon name="simple-icons:linkedin" class="social-icon" aria-hidden="true" />
        <span>LinkedIn TODO</span>
      </span>
    )}
  </div>
</div>

<style>
  .social-wrap {
    position: relative;
    z-index: 3;
    margin-top: -0.5rem;
  }

  .social-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.35rem, 3vw, 2rem);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.85rem 0;
  }

  a,
  .disabled-social {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 650;
  }

  a:hover {
    color: var(--text);
  }

  .disabled-social {
    opacity: 0.46;
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
    color: var(--accent-strong);
  }

  @media (max-width: 620px) {
    .social-strip {
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    a,
    .disabled-social {
      flex: none;
      scroll-snap-align: start;
    }
  }
</style>
