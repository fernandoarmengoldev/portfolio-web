---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
    {
        date: "Actualmente...",
        title: "Geriátrico Doña Rosa S.L.",
        description:
            "Desarrollador en Practicas, responsable de la creacion de varias webs usando Astro, Tailwind CSS, y TypeScript.",
    },
    {
        date: "Septiembre 2023 - Noviembre 2023",
        title: "Smart and Fun",
        description:
            "Desarrollador Junior, usando Ruby, Rails, HTML, CSS, JavaScript, y Bootstrap.",
    },
    {
        date: "Marzo 2022 - Junio 2022",
        title: "NTT Data",
        description:
            "Desarrollador en Practicas, responsable de mantenimiento y actualizacion del frontend de una web, usando Java, JS, HTML, CSS y Bootstrap.",
    },
];
---

<ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">
    {
        EXPERIENCE.map((experience) => (
            <li class="mb-10 ms-4">
                <ExperienceItem {...experience} />
            </li>
        ))
    }
</ol>
