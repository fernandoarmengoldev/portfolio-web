---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../data/profile';
import { getTranslations } from '../i18n/translations';
import { getProjectPath } from '../utils/projects';
import Header from './common/Header.astro';
import Footer from './common/Footer.astro';

interface Props {
  locale: Locale;
  project: CollectionEntry<'projects'>;
  previous?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
  esPath: string;
  enPath: string;
}

const { locale, project, previous, next, esPath, enPath } = Astro.props;
const t = getTranslations(locale);
const homePath = getRelativeLocaleUrl(locale, '');
const projectPath = (entry: CollectionEntry<'projects'>) => getProjectPath(locale, entry.data.slug);
const { data } = project;
const sections = [
  { title: t.project.problem, items: data.challenges },
  { title: t.project.solution, items: data.solutions },
  { title: t.project.decisions, items: data.technicalDecisions },
  { title: t.project.results, items: data.results },
];
---

<div id="top">
  <Header locale={locale} esPath={esPath} enPath={enPath} />
  <main id="main-content" class="solid">
    <article>
      <header class="shell intro">
        <a class="back" href={`${homePath}#projects`}>
          <Icon name="tabler:arrow-left" class="icon" aria-hidden="true" />
          {t.project.back}
        </a>
        <h1>{data.title}</h1>
        <p class="summary">{data.summary}</p>
        <dl class="meta">
          <div><dt>{t.project.year}</dt><dd>{data.year}</dd></div>
          <div><dt>{t.project.status}</dt><dd>{data.status}</dd></div>
          <div class="meta-stack">
            <dt>{t.project.technologies}</dt>
            <dd>
              <ul class="stack-list">{data.technologies.map((technology) => <li>{technology}</li>)}</ul>
            </dd>
          </div>
        </dl>
        {(data.githubUrl || data.demoUrl) && (
          <div class="external">
            {data.githubUrl && (
              <a class="btn btn-solid" href={data.githubUrl} target="_blank" rel="noreferrer">
                <Icon name="simple-icons:github" class="icon" aria-hidden="true" />
                {t.project.repository}
              </a>
            )}
            {data.demoUrl && (
              <a class="btn" href={data.demoUrl} target="_blank" rel="noreferrer">
                <Icon name="tabler:external-link" class="icon" aria-hidden="true" />
                {t.project.demo}
              </a>
            )}
          </div>
        )}
      </header>

      <div class="shell cover" data-reveal>
        <Picture
          src={data.image}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[720, 1080, 1440, 1920]}
          sizes="(max-width: 1400px) 92vw, 82rem"
          alt={data.imageAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="cover-image"
        />
      </div>

      <section class="shell frame">
        <header class="frame-head" data-reveal>
          <h2>{t.project.overview}</h2>
        </header>
        <p class="lede" data-reveal>{data.longDescription}</p>
      </section>

      {sections.map((section) => (
        <section class="shell frame">
          <header class="frame-head" data-reveal>
            <h2>{section.title}</h2>
          </header>
          <ul class="points" data-reveal-stagger>{section.items.map((item) => <li>{item}</li>)}</ul>
        </section>
      ))}

      <nav class="shell pager" aria-label={locale === 'es' ? 'Navegación entre proyectos' : 'Project navigation'}>
        {previous ? (
          <a href={projectPath(previous)} rel="prev">
            <span>{t.project.previous}</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : <span></span>}
        {next ? (
          <a href={projectPath(next)} rel="next" class="pager-next">
            <span>{t.project.next}</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  </main>
  <Footer locale={locale} esPath={esPath} enPath={enPath} />
</div>

<style>
  .intro {
    padding-top: calc(var(--nav-height) + clamp(3rem, 8vw, 6rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .back {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    color: var(--tide);
    font-size: var(--step--1);
    font-weight: 550;
    transition: color 160ms ease;
  }

  .back:hover {
    color: var(--caustic);
  }

  h1 {
    max-width: 16ch;
    margin-top: 1.5rem;
    font-size: clamp(2.6rem, 8vw, 6.5rem);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .summary {
    max-width: 46ch;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 3rem;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }

  .meta dt {
    color: var(--tide);
    font-size: var(--step--1);
  }

  .meta dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }

  .meta-stack dd .stack-list {
    color: var(--spray);
    font-size: var(--step-0);
  }

  .external {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .cover {
    margin-bottom: var(--section-space);
  }

  :global(.cover-image) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    object-fit: cover;
  }

  /* Case-study sections are short; tighten the shared frame rhythm */
  .frame {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .lede {
    max-width: 58ch;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .points {
    display: grid;
    gap: 0.9rem;
    max-width: 62ch;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .points li::marker {
    color: var(--caustic);
  }

  .pager {
    display: grid;
    gap: 1rem;
    border-top: 1px solid var(--rule);
    padding-block: 2rem var(--section-space);
  }

  .pager a {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.75rem;
  }

  .pager span {
    color: var(--tide);
    font-size: var(--step--1);
  }

  .pager strong {
    font-size: var(--step-1);
    font-stretch: 110%;
    font-weight: 680;
    transition: color 160ms ease;
  }

  .pager a:hover strong {
    color: var(--caustic);
  }

  @media (min-width: 700px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .pager-next {
      text-align: right;
    }
  }
</style>
