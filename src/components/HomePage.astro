---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/profile';
import { profile } from '../data/profile';
import { education } from '../data/education';
import { siteFeatures } from '../data/features';
import { getTranslations } from '../i18n/translations';
import { getProjectPath } from '../utils/projects';
import Header from './common/Header.astro';
import Footer from './common/Footer.astro';
import Hero from './sections/Hero.astro';
import ProjectCard from './cards/ProjectCard.astro';
import ExperienceTimeline from './sections/ExperienceTimeline.astro';
import TechnologyGrid from './sections/TechnologyGrid.astro';

interface Props {
  locale: Locale;
  projects: CollectionEntry<'projects'>[];
  esPath: string;
  enPath: string;
}

const { locale, projects, esPath, enPath } = Astro.props;
const t = getTranslations(locale);
const sortedProjects = projects.toSorted((a, b) => a.data.order - b.data.order);
const cvLinks = [
  { label: t.cv.spanish, href: profile.cv.esPath, available: profile.cv.esAvailable, lang: 'es' },
  { label: t.cv.english, href: profile.cv.enPath, available: profile.cv.enAvailable, lang: 'en' },
];
---

<div id="top">
  <Header locale={locale} esPath={esPath} enPath={enPath} isHome />
  <main id="main-content">
    <Hero locale={locale} />

    <div class="solid">
      <section id="experience" class="shell frame" aria-labelledby="experience-title">
        <header class="frame-head" data-reveal>
          <h2 id="experience-title">{t.experience.title}</h2>
          <p>{t.experience.body}</p>
        </header>
        <ExperienceTimeline locale={locale} />
      </section>

      {siteFeatures.projects && (
        <section id="projects" class="shell frame" aria-labelledby="projects-title">
          <header class="frame-head" data-reveal>
            <h2 id="projects-title">{t.projects.title}</h2>
            <p>{t.projects.body}</p>
          </header>
          <div class="project-list" data-reveal-stagger>
            {sortedProjects.map((project) => (
              <ProjectCard project={project} locale={locale} detailPath={getProjectPath(locale, project.data.slug)} />
            ))}
          </div>
        </section>
      )}

      <section id="technologies" class="shell frame" aria-labelledby="technologies-title">
        <header class="frame-head" data-reveal>
          <h2 id="technologies-title">{t.technologies.title}</h2>
          <p>{t.technologies.body}</p>
        </header>
        <TechnologyGrid locale={locale} />
      </section>

      <section id="education" class="shell frame" aria-labelledby="education-title">
        <header class="frame-head" data-reveal>
          <h2 id="education-title">{t.education.title}</h2>
          <p>{t.education.body}</p>
        </header>
        <ol class="education" data-reveal-stagger>
          {education.map((item) => (
            <li>
              <h3>{item.title[locale]}</h3>
              <p class="center">{item.center}</p>
              <p class="period">{item.period[locale]}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <section id="contact" class="contact" aria-labelledby="contact-title" data-water-window>
      <div class="shell contact-inner" data-reveal-stagger>
        <h2 id="contact-title">{t.contact.title}</h2>
        <p class="contact-body">{t.contact.body}</p>

        <p class="email-row">
          <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>

        <div class="contact-actions">
          <button
            class="btn copy"
            type="button"
            data-copy-email
            data-email={profile.email}
            data-success={t.contact.copied}
            data-error={t.contact.copyError}
          >
            <Icon name="tabler:copy" class="icon icon-copy" aria-hidden="true" />
            <Icon name="tabler:check" class="icon icon-check" aria-hidden="true" />
            <span data-copy-label>{t.contact.copy}</span>
          </button>
          <a class="btn" href={profile.githubUrl} target="_blank" rel="noreferrer" aria-label={t.social.github}>
            <Icon name="simple-icons:github" class="icon" aria-hidden="true" />
            GitHub
          </a>
          {profile.linkedinUrl && (
            <a class="btn" href={profile.linkedinUrl} target="_blank" rel="noreferrer" aria-label={t.social.linkedin}>
              <Icon name="simple-icons:linkedin" class="icon" aria-hidden="true" />
              LinkedIn
            </a>
          )}
        </div>
        <p class="sr-feedback" aria-live="polite" data-copy-feedback></p>

        <div class="contact-details">
          <div id="cv" class="cv">
            <h3>{t.cv.title}</h3>
            <p>{t.cv.body}</p>
            <ul>
              {cvLinks.map((link) => (
                <li>
                  {link.available ? (
                    <a class="cv-link" href={link.href} download hreflang={link.lang}>
                      <Icon name="tabler:file-type-pdf" class="icon" aria-hidden="true" />
                      <span class="cv-label">{link.label}</span>
                      <Icon name="tabler:download" class="icon cv-download" aria-hidden="true" />
                    </a>
                  ) : (
                    <span class="cv-link is-disabled">
                      <Icon name="tabler:file-type-pdf" class="icon" aria-hidden="true" />
                      <span class="cv-label">{link.label}</span>
                      <span class="soon">{t.cv.soon}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>

          <dl class="facts">
            <div>
              <dt><Icon name="tabler:map-pin" class="icon" aria-hidden="true" /><span class="sr-only">{locale === 'es' ? 'Ubicación' : 'Location'}</span></dt>
              <dd>{t.contact.location}</dd>
            </div>
            <div>
              <dt><Icon name="tabler:circle-check" class="icon" aria-hidden="true" /><span class="sr-only">{locale === 'es' ? 'Disponibilidad' : 'Availability'}</span></dt>
              <dd>{profile.availability[locale]}</dd>
            </div>
            <div>
              <dt><Icon name="tabler:language" class="icon" aria-hidden="true" /><span class="sr-only">{t.about.languagesLabel}</span></dt>
              <dd>{t.about.languages}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} esPath={esPath} enPath={enPath} />
</div>

<style>
  .project-list {
    display: grid;
    gap: 3rem;
  }

  .education {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .education li {
    display: grid;
    gap: 0.2rem;
    border-bottom: 1px solid var(--rule);
    padding-block: 1.5rem;
  }

  .education li:first-child {
    padding-top: 0;
  }

  .education h3 {
    transition: color 200ms ease;
  }

  .education li:hover h3 {
    color: var(--caustic);
  }

  .education h3 {
    font-size: var(--step-1);
    font-weight: 620;
    line-height: 1.3;
  }

  .center {
    color: var(--tide);
  }

  .period {
    color: var(--tide);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 700px) {
    .education li {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 2rem;
    }

    .education h3 {
      grid-column: 1;
    }

    .center {
      grid-column: 1;
    }

    .period {
      grid-column: 2;
      grid-row: 1;
      padding-top: 0.2rem;
      text-align: right;
    }
  }

  /* Contact: the water shows through again */
  .contact {
    position: relative;
    padding-block: var(--section-space) clamp(3rem, 6vw, 5rem);
  }

  .contact::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--abyss) 0%, rgba(4, 22, 30, 0.35) 30%, rgba(4, 22, 30, 0.6) 100%);
    content: '';
    pointer-events: none;
  }

  .contact-inner {
    position: relative;
  }

  .contact h2 {
    max-width: 18ch;
    font-size: var(--step-4);
    font-stretch: 115%;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1;
    text-wrap: balance;
  }

  .contact-body {
    margin-top: 1.25rem;
    color: var(--tide);
    font-size: var(--step-1);
  }

  .email {
    display: inline-block;
    max-width: 100%;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 2px solid var(--rule-strong);
    padding-bottom: 0.2rem;
    color: var(--caustic);
    font-size: clamp(1.35rem, 6.2vw, 4.75rem);
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .email {
    position: relative;
  }

  /* A caustic line sweeps across the resting underline on hover */
  .email::after {
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;
    height: 2px;
    background: var(--caustic);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 520ms var(--ease-out);
  }

  .email:hover {
    color: var(--spray);
  }

  .email:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .copy :global(.icon-check),
  .copy[data-state='copied'] :global(.icon-copy) {
    display: none;
  }

  .copy[data-state='copied'] {
    border-color: var(--caustic);
    color: var(--caustic);
  }

  .copy[data-state='copied'] :global(.icon-check) {
    display: block;
    animation: pop 420ms var(--ease-out);
  }

  @keyframes pop {
    from {
      transform: scale(0.3) rotate(-20deg);
    }
    60% {
      transform: scale(1.25);
    }
  }

  .sr-feedback,
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .contact-details {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
  }

  .cv h3 {
    font-size: var(--step-1);
    font-weight: 650;
  }

  .cv p {
    margin-top: 0.25rem;
    color: var(--tide);
    font-size: var(--step--1);
  }

  .cv ul {
    display: grid;
    max-width: 28rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .cv-link {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--rule);
    font-weight: 550;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .cv-label {
    flex: 1;
  }

  a.cv-link:hover {
    border-color: var(--caustic);
    color: var(--caustic);
  }

  .cv-link :global(.cv-download) {
    color: var(--tide);
    transition: transform 200ms var(--ease-out);
  }

  a.cv-link:hover :global(.cv-download) {
    color: var(--caustic);
    transform: translateY(2px);
  }

  .is-disabled {
    color: var(--tide);
  }

  .soon {
    font-size: var(--step--1);
  }

  .facts {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    margin: 0;
  }

  .facts div {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .facts dt {
    color: var(--caustic);
  }

  .facts dd {
    margin: 0;
    color: var(--spray);
  }

  @media (min-width: 900px) {
    .contact-details {
      grid-template-columns: 1fr 1fr;
      gap: var(--gutter);
    }

    .facts {
      padding-top: 0.35rem;
    }
  }
</style>
