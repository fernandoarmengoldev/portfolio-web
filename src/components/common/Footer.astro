---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../data/profile';
import { profile } from '../../data/profile';
import { getTranslations } from '../../i18n/translations';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  esPath: string;
  enPath: string;
}

const { locale, esPath, enPath } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer-inner">
    <p class="credit">
      <span>© {year} {profile.name}</span>
      <span class="built">{t.footer.built}</span>
    </p>
    <nav aria-label={locale === 'es' ? 'Enlaces del pie de página' : 'Footer links'}>
      <a href={profile.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      <a href={`mailto:${profile.email}`}>{locale === 'es' ? 'Correo' : 'Email'}</a>
      <a href="#top">
        {t.footer.top}
        <Icon name="tabler:arrow-up" class="icon" aria-hidden="true" />
      </a>
    </nav>
    <LanguageSwitcher locale={locale} esPath={esPath} enPath={enPath} label={t.languageLabel} />
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: rgba(4, 22, 30, 0.6);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem;
    color: var(--tide);
    font-size: var(--step--1);
  }

  .credit {
    display: grid;
    margin-right: auto;
  }

  .credit span:first-child {
    color: var(--spray);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    transition: color 160ms ease;
  }

  nav a:hover {
    color: var(--spray);
  }

  nav :global(.icon) {
    transition: transform 260ms var(--ease-out);
  }

  nav a:hover :global(.icon) {
    transform: translateY(-3px);
  }
</style>
