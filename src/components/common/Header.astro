---
import { Icon } from 'astro-icon/components';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../data/profile';
import { profile } from '../../data/profile';
import { siteFeatures } from '../../data/features';
import { getTranslations } from '../../i18n/translations';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  esPath: string;
  enPath: string;
  isHome?: boolean;
}

const { locale, esPath, enPath, isHome = false } = Astro.props;
const t = getTranslations(locale);
const homePath = getRelativeLocaleUrl(locale, '');
const anchorPath = (id: string) => `${isHome ? '' : homePath}#${id}`;
const navItems = [
  ['experience', t.nav.experience],
  ['projects', t.nav.projects],
  ['technologies', t.nav.technologies],
  ['education', t.nav.education],
  ['contact', t.nav.contact],
] as const;
const visibleNavItems = navItems.filter(([id]) => siteFeatures.projects || id !== 'projects');
const cvAvailable = profile.cv[locale === 'es' ? 'esAvailable' : 'enAvailable'];
const cvHref = cvAvailable ? profile.cv[locale === 'es' ? 'esPath' : 'enPath'] : anchorPath('cv');
---

<header class="site-header" data-site-header>
  <div class="shell bar">
    <a class="brand" href={homePath} aria-label={`${profile.name}, ${t.nav.home}`}>
      <span aria-hidden="true">Fernando D. Armengol</span>
    </a>

    <nav class="nav-desktop" aria-label={t.navLabel}>
      {visibleNavItems.map(([id, label]) => (
        <a href={anchorPath(id)} data-section-link={isHome ? '' : undefined}>{label}</a>
      ))}
    </nav>

    <div class="actions-desktop">
      <LanguageSwitcher locale={locale} esPath={esPath} enPath={enPath} label={t.languageLabel} />
      <a class="btn" href={cvHref} download={cvAvailable ? '' : undefined}>
        <Icon name="tabler:download" class="icon" aria-hidden="true" />
        {t.nav.cv}
      </a>
    </div>

    <details class="menu">
      <summary>
        <span class="sr-only menu-open">{t.menuOpen}</span>
        <span class="sr-only menu-close">{t.menuClose}</span>
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </summary>
      <div class="menu-panel">
        <nav aria-label={t.navLabel}>
          {visibleNavItems.map(([id, label], index) => (
            <a href={anchorPath(id)} data-menu-link style={`--i: ${index}`}>{label}</a>
          ))}
        </nav>
        <div class="menu-actions" style={`--i: ${visibleNavItems.length}`}>
          <LanguageSwitcher locale={locale} esPath={esPath} enPath={enPath} label={t.languageLabel} />
          <a class="btn btn-solid" href={cvHref} download={cvAvailable ? '' : undefined} data-menu-link>
            <Icon name="tabler:download" class="icon" aria-hidden="true" />
            {t.nav.cv}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    left: 0;
    border-bottom: 1px solid transparent;
    transition: background-color 240ms ease, border-color 240ms ease, transform 360ms var(--ease-out);
  }

  .site-header[data-hidden] {
    transform: translateY(-100%);
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--rule);
    background: rgba(4, 22, 30, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .bar {
    display: flex;
    height: var(--nav-height);
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    font-size: 0.95rem;
    font-stretch: 125%;
    font-weight: 750;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav-desktop {
    display: none;
    gap: 2rem;
    margin-right: auto;
    margin-left: 1rem;
  }

  .nav-desktop a {
    position: relative;
    padding-block: 0.4rem;
    color: var(--tide);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 160ms ease;
  }

  .nav-desktop a:hover,
  .nav-desktop a[aria-current] {
    color: var(--spray);
  }

  .nav-desktop a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--caustic);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 240ms var(--ease-out);
  }

  .nav-desktop a[aria-current]::after {
    transform: scaleX(1);
  }

  .actions-desktop {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }

  .menu summary {
    display: grid;
    width: 2.875rem;
    height: 2.875rem;
    place-items: center;
    border: 1px solid var(--rule-strong);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  /* Three bars that fold into a cross */
  .burger {
    position: relative;
    width: 1.25rem;
    height: 0.875rem;
  }

  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 360ms var(--ease-out), opacity 200ms ease;
  }

  .burger span:nth-child(1) {
    top: 0;
  }

  .burger span:nth-child(2) {
    top: calc(50% - 1px);
  }

  .burger span:nth-child(3) {
    bottom: 0;
    width: 70%;
  }

  .menu[open]:not(.is-closing) .burger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu[open]:not(.is-closing) .burger span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .menu[open]:not(.is-closing) .burger span:nth-child(3) {
    width: 100%;
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu summary {
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .menu[open] summary {
    border-color: var(--caustic);
    background: rgba(139, 234, 240, 0.08);
  }

  .menu .menu-close,
  .menu[open] .menu-open {
    display: none;
  }

  .menu[open] .menu-close {
    display: block;
  }

  .menu-panel {
    position: absolute;
    top: var(--nav-height);
    right: 0;
    left: 0;
    display: grid;
    gap: 2rem;
    border-bottom: 1px solid var(--rule);
    background: var(--abyss);
    padding: 1.5rem var(--gutter) 2rem;
    animation: panel-in 420ms var(--ease-out);
  }

  .menu-panel nav a,
  .menu-actions {
    animation: item-in 480ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 55ms + 90ms);
  }

  .menu.is-closing .menu-panel {
    animation: panel-out 240ms ease-in forwards;
  }

  @keyframes panel-in {
    from {
      clip-path: inset(0 0 100% 0);
      opacity: 0.4;
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes panel-out {
    to {
      clip-path: inset(0 0 100% 0);
      opacity: 0;
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(-0.6rem);
    }
  }

  .menu-panel nav {
    display: grid;
  }

  .menu-panel nav a {
    border-bottom: 1px solid var(--rule);
    padding-block: 0.85rem;
    font-size: var(--step-2);
    font-stretch: 112%;
    font-weight: 650;
    transition: color 160ms ease, padding-left 260ms var(--ease-out);
  }

  .menu-panel nav a:hover {
    padding-left: 0.5rem;
    color: var(--caustic);
  }

  .menu-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 1000px) {
    .nav-desktop,
    .actions-desktop {
      display: flex;
    }

    .menu {
      display: none;
    }
  }
</style>

<script>
  // Let <details> play a closing animation, and close on Escape or outside tap.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const panel = menu?.querySelector<HTMLElement>('.menu-panel');

  const closeMenu = () => {
    if (!menu?.open || menu.classList.contains('is-closing')) return;
    menu.classList.add('is-closing');
    panel?.addEventListener(
      'animationend',
      () => {
        menu.open = false;
        menu.classList.remove('is-closing');
      },
      { once: true },
    );
  };

  menu?.querySelector('summary')?.addEventListener('click', (event) => {
    if (!menu.open) return;
    event.preventDefault();
    closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !menu?.open) return;
    closeMenu();
    menu.querySelector('summary')?.focus();
  });

  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) closeMenu();
  });
</script>
