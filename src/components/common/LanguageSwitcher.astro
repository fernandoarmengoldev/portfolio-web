---
import type { Locale } from '../../data/profile';

interface Props {
  locale: Locale;
  esPath: string;
  enPath: string;
  label: string;
}

const { locale, esPath, enPath, label } = Astro.props;
---

<nav class="language-switcher" aria-label={label}>
  <a href={esPath} lang="es" hreflang="es" aria-current={locale === 'es' ? 'page' : undefined} aria-label="Español">ES</a>
  <span aria-hidden="true">/</span>
  <a href={enPath} lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined} aria-label="English">EN</a>
</nav>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    color: var(--tide);
    font-size: 0.85rem;
    font-weight: 600;
  }

  a {
    display: inline-grid;
    min-width: 2rem;
    min-height: 2.75rem;
    place-items: center;
    transition: color 160ms ease;
  }

  a:hover {
    color: var(--spray);
  }

  a[aria-current='page'] {
    color: var(--caustic);
  }

  span {
    opacity: 0.5;
  }
</style>
