<div class="water" aria-hidden="true">
  <canvas data-water-canvas></canvas>
</div>

<style>
  .water {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 72% 18%, #0d4553 0%, transparent 55%),
      linear-gradient(180deg, #072a36, var(--abyss) 80%);
  }

  canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease;
  }

  canvas[data-water-ready] {
    opacity: 1;
  }
</style>

<script>
  /*
   * Mediterranean surface rendered as a single full-screen WebGL pass.
   * The canvas is fixed behind the page; it only animates while an element
   * marked [data-water-window] (hero, contact) is on screen.
   */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-water-canvas]');
  const gl = canvas?.getContext('webgl', {
    alpha: false,
    antialias: false,
    depth: false,
    stencil: false,
    powerPreference: 'low-power',
  });

  const vertexSource = `
    attribute vec2 aPosition;
    varying vec2 vUv;
    void main() {
      vUv = aPosition * 0.5 + 0.5;
      gl_Position = vec4(aPosition, 0.0, 1.0);
    }
  `;

  const fragmentSource = `
    precision highp float;
    varying vec2 vUv;
    uniform vec2 uResolution;
    uniform float uTime;
    uniform vec3 uRipples[8];

    vec3 wave(vec2 p, vec2 dir, float freq, float speed, float amp) {
      float phase = dot(p, dir) * freq + uTime * speed;
      return vec3(sin(phase) * amp, cos(phase) * dir * freq * amp);
    }

    vec3 field(vec2 p, float aspect) {
      vec3 f = vec3(0.0);
      f += wave(p, normalize(vec2(1.0, 0.22)), 2.3, 0.5, 0.06);
      f += wave(p, normalize(vec2(-0.38, 1.0)), 3.7, -0.7, 0.036);
      f += wave(p, normalize(vec2(0.72, 1.0)), 6.1, 1.05, 0.017);
      f += wave(p, normalize(vec2(-1.0, 0.48)), 9.4, -1.35, 0.009);
      f += wave(p, normalize(vec2(0.55, -1.0)), 14.5, 1.8, 0.004);

      for (int i = 0; i < 8; i++) {
        vec3 r = uRipples[i];
        float age = uTime - r.z;
        float alive = step(0.0, age) * (1.0 - step(4.0, age));
        vec2 center = (r.xy - 0.5) * vec2(aspect, 1.0) * 2.4;
        vec2 delta = p - center;
        float dist = max(length(delta), 0.0001);
        float ring = dist - age * 0.38;
        float amp = 0.032 * exp(-abs(ring) * 8.5) * exp(-age * 0.62) * alive;
        f.x += sin(ring * 30.0) * amp;
        f.yz += cos(ring * 30.0) * 30.0 * amp * delta / dist;
      }
      return f;
    }

    void main() {
      float aspect = uResolution.x / max(uResolution.y, 1.0);
      vec2 c = (vUv - 0.5) * vec2(aspect, 1.0);
      vec2 p = c * 2.4;
      vec3 f = field(p, aspect);

      vec3 n = normalize(vec3(-f.y * 0.86, -f.z * 0.86, 1.0));
      vec3 light = normalize(vec3(-0.42, 0.64, 0.72));
      vec3 view = normalize(vec3(c * 0.14, 1.0));
      vec3 h = normalize(light + view);

      float diffuse = max(dot(n, light), 0.0);
      float spec = pow(max(dot(n, h), 0.0), 92.0);
      float sheen = pow(max(dot(n, h), 0.0), 18.0);
      float fresnel = pow(1.0 - max(dot(n, view), 0.0), 3.0);

      vec2 w = p * 3.1 + f.yz * 0.32;
      float caustic = pow(max(0.0, sin(w.x * 2.0 + sin(w.y * 1.35 - uTime * 0.42)) * sin(w.y * 2.35 - sin(w.x * 1.15 + uTime * 0.36))), 4.0);

      vec3 deep = vec3(0.016, 0.086, 0.118);
      vec3 shallow = vec3(0.035, 0.17, 0.2);
      vec3 cyan = vec3(0.545, 0.918, 0.941);
      vec3 sky = vec3(0.2, 0.46, 0.52);

      float depth = smoothstep(-0.6, 0.75, c.y + f.x * 1.6);
      float pool = exp(-length((vUv - vec2(0.74, 0.8)) * vec2(1.0, 1.35)) * 2.4);
      vec3 col = mix(deep, shallow, depth * 0.7 + pool * 0.25);
      col += cyan * diffuse * 0.06;
      col += sky * fresnel * 0.34;
      col += cyan * spec * 0.6;
      col += sky * sheen * 0.1;
      col += cyan * caustic * 0.025;
      col += cyan * abs(f.x) * 0.12;

      float vignette = 1.0 - smoothstep(0.34, 1.05, length(c / vec2(max(aspect, 1.0), 1.0)));
      col *= mix(0.7, 1.0, vignette);
      gl_FragColor = vec4(pow(col, vec3(0.93)), 1.0);
    }
  `;

  const compile = (context: WebGLRenderingContext, type: number, source: string) => {
    const shader = context.createShader(type);
    if (!shader) return null;
    context.shaderSource(shader, source);
    context.compileShader(shader);
    if (context.getShaderParameter(shader, context.COMPILE_STATUS)) return shader;
    context.deleteShader(shader);
    return null;
  };

  const vertexShader = gl && compile(gl, gl.VERTEX_SHADER, vertexSource);
  const fragmentShader = gl && compile(gl, gl.FRAGMENT_SHADER, fragmentSource);
  const program = gl && vertexShader && fragmentShader ? gl.createProgram() : null;

  if (canvas && gl && program && vertexShader && fragmentShader) {
    gl.attachShader(program, vertexShader);
    gl.attachShader(program, fragmentShader);
    gl.linkProgram(program);

    if (gl.getProgramParameter(program, gl.LINK_STATUS)) {
      gl.useProgram(program);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const position = gl.getAttribLocation(program, 'aPosition');
      gl.enableVertexAttribArray(position);
      gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

      const uResolution = gl.getUniformLocation(program, 'uResolution');
      const uTime = gl.getUniformLocation(program, 'uTime');
      const uRipples = gl.getUniformLocation(program, 'uRipples[0]');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
      const frameInterval = coarsePointer || saveData ? 1000 / 30 : 0;
      const maxPixels = coarsePointer ? 800_000 : 1_500_000;
      let quality = saveData ? 0.6 : coarsePointer ? 0.75 : 1;

      const ripples = new Float32Array(24).fill(-100);
      const startedAt = performance.now();
      let rippleIndex = 0;
      let frame = 0;
      let lastFrame = 0;
      let fpsWindowStart = 0;
      let fpsFrames = 0;
      let running = false;
      const visibleWindows = new Set<Element>();

      const resize = () => {
        const budget = Math.sqrt(maxPixels / Math.max(innerWidth * innerHeight, 1));
        const ratio = Math.min(devicePixelRatio || 1, 1.15, budget) * quality;
        const width = Math.max(1, Math.floor(innerWidth * ratio));
        const height = Math.max(1, Math.floor(innerHeight * ratio));
        if (canvas.width !== width || canvas.height !== height) {
          canvas.width = width;
          canvas.height = height;
          gl.viewport(0, 0, width, height);
        }
      };

      const render = (now: number) => {
        gl.uniform2f(uResolution, canvas.width, canvas.height);
        gl.uniform1f(uTime, reducedMotion.matches ? 4 : (now - startedAt) / 1000);
        gl.uniform3fv(uRipples, ripples);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        canvas.dataset.waterReady = '';
      };

      const tick = (now: number) => {
        if (!running) return;
        frame = requestAnimationFrame(tick);
        if (frameInterval && now - lastFrame < frameInterval - 1) return;
        lastFrame = now;
        render(now);

        // Drop resolution on slow machines instead of dropping frames.
        fpsFrames += 1;
        if (now - fpsWindowStart >= 1200) {
          const fps = (fpsFrames * 1000) / (now - fpsWindowStart);
          if (!frameInterval && fps < 48 && quality > 0.5) {
            quality = Math.max(0.5, quality * (fps < 36 ? 0.72 : 0.85));
            resize();
          }
          fpsFrames = 0;
          fpsWindowStart = now;
        }
      };

      const start = () => {
        if (running || document.hidden || visibleWindows.size === 0) return;
        if (reducedMotion.matches) {
          render(performance.now());
          return;
        }
        running = true;
        fpsWindowStart = performance.now();
        fpsFrames = 0;
        frame = requestAnimationFrame(tick);
      };

      const stop = () => {
        running = false;
        cancelAnimationFrame(frame);
      };

      const windowObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visibleWindows.add(entry.target);
          else visibleWindows.delete(entry.target);
        });
        if (visibleWindows.size) start();
        else stop();
      });
      document.querySelectorAll('[data-water-window]').forEach((element) => windowObserver.observe(element));

      window.addEventListener(
        'pointerdown',
        (event) => {
          if (reducedMotion.matches || !(event.target as Element).closest?.('[data-water-window]')) return;
          const offset = rippleIndex * 3;
          ripples[offset] = event.clientX / Math.max(innerWidth, 1);
          ripples[offset + 1] = 1 - event.clientY / Math.max(innerHeight, 1);
          ripples[offset + 2] = (performance.now() - startedAt) / 1000;
          rippleIndex = (rippleIndex + 1) % 8;
        },
        { passive: true },
      );

      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      reducedMotion.addEventListener('change', () => {
        stop();
        start();
      });
      new ResizeObserver(() => {
        resize();
        if (!running && visibleWindows.size) render(performance.now());
      }).observe(document.documentElement);

      resize();
    }
  }
</script>
