---
import '@fontsource-variable/mona-sans/wdth.css';
import '../styles/global.css';
import { profile, type Locale } from '../data/profile';
import { getTranslations } from '../i18n/translations';
import profileImage from '../assets/images/fernando-armengol.png';
import WaterBackground from '../components/common/WaterBackground.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  canonicalPath: string;
  esPath: string;
  enPath: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: { src: string };
  ogType?: 'website' | 'article';
}

const { locale, canonicalPath, esPath, enPath, jsonLd } = Astro.props;
const t = getTranslations(locale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const canonical = new URL(canonicalPath, Astro.site);
const esUrl = new URL(esPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);
const socialImage = new URL(Astro.props.ogImage?.src ?? profileImage.src, Astro.site);
const structuredData = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: locale === 'es' ? profile.role : 'Full-stack Software Developer',
  email: `mailto:${profile.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Alicante',
    addressCountry: 'ES',
  },
  url: canonical.origin,
  sameAs: [profile.githubUrl],
  knowsAbout: ['Web development', 'Android', 'Linux', 'Web security', 'Software performance'],
};
const safeJsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#04161e" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content={Astro.props.ogType ?? 'website'} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={t.hero.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={safeJsonLd}></script>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skip}</a>
    <WaterBackground />
    <div class="site-content">
      <slot />
    </div>
    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      // Eased mouse-wheel scrolling on desktop. Touch keeps native scrolling, and
      // reduced-motion visitors skip it entirely (Lenis would still ease the wheel).
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (finePointer && !reducedMotion) {
        new Lenis({ autoRaf: true, anchors: true, lerp: 0.085 });
      }

      const header = document.querySelector<HTMLElement>('[data-site-header]');
      if (header) {
        // Solid once scrolled; tucks away while scrolling down, returns on scroll up.
        let lastY = window.scrollY;
        const updateHeader = () => {
          const y = window.scrollY;
          const menuOpen = header.querySelector('details[open]');
          header.toggleAttribute('data-scrolled', y > 24);
          header.toggleAttribute('data-hidden', !menuOpen && y > lastY && y > 320);
          lastY = y;
        };
        updateHeader();
        window.addEventListener('scroll', updateHeader, { passive: true });
        header.addEventListener('focusin', () => header.removeAttribute('data-hidden'));
      }

      if (document.documentElement.classList.contains('js-motion')) {
        document.querySelectorAll<HTMLElement>('[data-reveal-stagger]').forEach((group) => {
          Array.from(group.children).forEach((child, index) => (child as HTMLElement).style.setProperty('--i', String(index)));
        });
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((element) => revealObserver.observe(element));
      }

      const sectionLinks = document.querySelectorAll('[data-section-link]');
      const sections = document.querySelectorAll('main section[id]');
      if (sectionLinks.length && sections.length && 'IntersectionObserver' in window) {
        const navObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (!visible) return;
            sectionLinks.forEach((link) => {
              const isCurrent = link.getAttribute('href')?.endsWith(`#${visible.target.id}`);
              if (isCurrent) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          },
          { rootMargin: '-30% 0px -60% 0px', threshold: [0, 0.2, 0.7] },
        );
        sections.forEach((section) => navObserver.observe(section));
      }

      document.querySelectorAll('[data-menu-link]').forEach((link) => {
        link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
      });

      document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
        const label = button.querySelector('[data-copy-label]');
        const idleText = label?.textContent ?? '';
        let resetTimer = 0;
        button.addEventListener('click', async () => {
          const feedback = document.querySelector('[data-copy-feedback]');
          window.clearTimeout(resetTimer);
          try {
            await navigator.clipboard.writeText(button.dataset.email ?? '');
            if (label) label.textContent = button.dataset.success ?? '';
            if (feedback) feedback.textContent = button.dataset.success ?? '';
            button.dataset.state = 'copied';
          } catch {
            if (feedback) feedback.textContent = button.dataset.error ?? '';
          }
          resetTimer = window.setTimeout(() => {
            if (label) label.textContent = idleText;
            delete button.dataset.state;
          }, 2400);
        });
      });
    </script>
  </body>
</html>
