---
import "@fontsource-variable/onest";
---	

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="" />
		<title>Fernando Daniel Armengol González - Portfolio</title>
		<meta name="description" content="Portfolio of Fernando Daniel Armengol González">
		<meta name="author" content="Fernando Daniel Armengol González">
		<meta name="keywords" content="Fernando Daniel Armengol González, Portfolio, Fernando Daniel Armengol, Armengol, Fernando, Daniel, Armengol, Fernando Daniel, Fernando Daniel Armengol, Fernando Daniel Armengol González">
	</head>
	<body class="relative min-h-screen bg-neutral-950">
		<div class="pointer-events-none absolute inset-0 z-[-2] bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
		<slot />
	</body>
</html>

<style is:global>
	@import "tailwindcss";

	html {
		font-family: "Onest Variable", system-ui, sans-serif;
		scroll-behavior: smooth;
	}

	:root {
		color-scheme: light dark;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
